# Cấu hình stack độc lập (docker-compose.yml ở gốc repo).
# Tạo .env tự động:  python scripts/init_standalone_env.py
# Script điền sẵn SECRET_KEY, POSTGRES_PASSWORD và hai token Intelligence.
# KHÔNG commit file .env.

# ---------- Bắt buộc (script tự sinh) ----------
SECRET_KEY=
POSTGRES_PASSWORD=
INTELLIGENCE_SERVICE_TOKEN=
INTELLIGENCE_INDEX_SCOPE_TOKEN=

POSTGRES_DB=msbradar
POSTGRES_USER=msbradar

# ---------- Tên miền ----------
# ":80" = thử trên máy (mở http://localhost). Khi lên server, đặt tên miền thật
# (vd radar.congty.vn) — Caddy tự xin TLS. Bắt buộc HTTPS ngoài localhost vì Hub
# (DEBUG=False) dùng cookie Secure giống production.
SITE_ADDRESS=:80
ALLOWED_HOSTS=localhost,127.0.0.1
# Khi có tên miền: CSRF_TRUSTED_ORIGINS=https://radar.congty.vn
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
# Đặt https://<tên miền> để ảnh xem trước/ảnh email là URL tuyệt đối đúng.
PUBLIC_BASE_URL=
# PUBLIC_APP_ICON_URL=https://radar.congty.vn/apple-touch-icon.png
# Chỉ đặt False nếu tên miền chưa sẵn sàng tham gia HSTS preload.
SECURE_HSTS_PRELOAD=True
HTTP_PORT=80
HTTPS_PORT=443

SESSION_COOKIE_AGE_SECONDS=604800
EDGE_SYNC_MAX_BATCH=500

# ---------- Lưu trữ file ----------
# local = volume Docker `filestore` (mặc định). r2 = Cloudflare R2 như production.
FILE_STORAGE_BACKEND=local
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=

# ---------- Nhà cung cấp LLM ----------
# Chỉ cần khoá; nhà cung cấp không có khoá tự bị bỏ qua. Có thể cấu hình tiếp
# trong UI /settings (lưu trong CSDL) như bản đang chạy.
MSB_AI_GREENNODE_API_KEY=
MSB_AI_GREENNODE_MODEL=
MSB_AI_GREENNODE_BASE_URL=
MSB_AI_OPENAI_API_KEY=
MSB_AI_GEMINI_API_KEY=
MSB_AI_DEEPSEEK_API_KEY=
MSB_AI_PROVIDER_DEFAULT=
MSB_AI_PROVIDER_FALLBACK=

# ---------- Trợ lý (giá trị mặc định giống production) ----------
ASSISTANT_INTENT_ROUTER=1
ASSISTANT_WEB_SEARCH=1
ASSISTANT_WEBSEARCH_DDG=1
ASSISTANT_TOOLS=0
ASSISTANT_TOOLS_TIER3=0
ASSISTANT_GRAPH=0
TALENT_SOFT_RETRIEVAL=1
INTEL_AUTO_ENQUEUE_EXTRACTION=1
TALENT_EMBEDDING_DIMENSIONS=1536
TALENT_DEEP_READ_POOL=60
# SEARXNG_URL=http://searxng:8080   # khi chạy --profile searxng

# ---------- Intelligence V2 (docker compose --profile intelligence) ----------
# Bật 1 CHỈ KHI đã chạy profile intelligence và đặt khoá GreenNode ở trên.
INTELLIGENCE_V2_PRIMARY=false
GREENNODE_MODEL_EMBEDDING=

# Prospect Agent (product_core/agent) — tuỳ chọn, để trống thì Hub tự làm.
MSB_AGENT_ENDPOINT=
