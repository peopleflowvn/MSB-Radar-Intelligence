# Chép thành .env rồi điền. KHÔNG commit file .env.
# Sinh SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

SECRET_KEY=
POSTGRES_PASSWORD=
INTELLIGENCE_SERVICE_TOKEN=
INTELLIGENCE_INDEX_SCOPE_TOKEN=
INTELLIGENCE_BASE_URL=http://intelligence:8081
INTELLIGENCE_V2_PRIMARY=false

POSTGRES_DB=msbradar
POSTGRES_USER=msbradar

# Tên miền phục vụ. ":80" để thử cục bộ; đặt tên miền thật thì Caddy tự xin TLS.
SITE_ADDRESS=:80

# Django chặn Host header không nằm trong danh sách này.
ALLOWED_HOSTS=localhost,127.0.0.1

# Bắt buộc khi chạy sau HTTPS, nếu không trang quản trị sẽ báo lỗi CSRF.
CSRF_TRUSTED_ORIGINS=

# Chỉ đặt False nếu tên miền chưa sẵn sàng tham gia HSTS preload.
SECURE_HSTS_PRELOAD=True

# Chỉ cần khi frontend chạy ở tên miền khác Hub. Cùng tên miền thì để trống.
CORS_ALLOWED_ORIGINS=

# ---------- Email OTP (Resend) ----------
# API key, email gửi và thời hạn mã được cấu hình bởi Admin trong Hub, không đặt ở đây.
# SECRET_KEY vẫn bắt buộc: Hub dùng nó để mã hóa API key Resend trong CSDL.
# Phiên đăng nhập mặc định một tuần. Không đặt biến này nếu dùng mặc định.
SESSION_COOKIE_AGE_SECONDS=604800

# Số bản ghi tối đa Hub nhận trong một lô đồng bộ.
EDGE_SYNC_MAX_BATCH=500

# ---------- Lưu trữ file (docs/STORAGE.md) ----------
# local = ổ đĩa VPS Oracle (mặc định). Trên VPS nên trỏ ra ngoài thư mục mã nguồn.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_ROOT=/var/lib/msbradar/filestore
# Chỉ cần khi FILE_STORAGE_BACKEND=r2 (cần thêm: pip install boto3)
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# ---------- Nhà cung cấp LLM (docs/AI_PROVIDERS.md) ----------
# Chỉ cần đặt khoá; base_url và model đã có mặc định.
# Nhà cung cấp chưa có khoá sẽ tự bị bỏ qua.

# GreenNode — lấy ở Workshop #1 (28/08). Khoá mới tạo ở trạng thái pending,
# phải đợi chuyển ACTIVE mới dùng được. Cách lấy mã model: AI_PROVIDERS.md mục 6.
MSB_AI_GREENNODE_API_KEY=
MSB_AI_GREENNODE_MODEL=

# Mỗi biến nhận NHIỀU khoá, cách nhau bởi dấu phẩy. Hạn mức tốc độ tính theo từng
# khoá, nên nhiều khoá = nhiều hạn mức hơn. Hệ thống tự xoay vòng và cho khoá bị
# chặn nghỉ 60 giây. Xem docs/AI_PROVIDERS.md.
MSB_AI_OPENAI_API_KEY=
MSB_AI_GEMINI_API_KEY=
MSB_AI_DEEPSEEK_API_KEY=

# Thứ tự ưu tiên. Không đặt thì mặc định: greennode -> openai -> gemini -> deepseek
MSB_AI_PROVIDER_DEFAULT=
MSB_AI_PROVIDER_FALLBACK=

# Mã model đổi vài tháng một lần; đổi ở đây, không sửa code.
# MSB_AI_OPENAI_MODEL=gpt-5.5
# MSB_AI_GEMINI_MODEL=gemini-3.5-flash
# MSB_AI_DEEPSEEK_MODEL=deepseek-v4-flash

# --- Embedding cho dense retrieval kho CV (hỏi đáp kiểu NotebookLM) ---
# Nguồn embedding chọn Ở /settings → panel "Nguồn embedding" (lưu trong DB, thắng
# các biến dưới đây). Mặc định: Gemini API (khoá đặt ở /settings → thẻ Gemini).
# Các biến dưới CHỈ là fallback khi DB chưa cấu hình:
# TALENT_EMBEDDING_BASE_URL=http://ollama:11434/v1   # nếu tự host Ollama
# TALENT_EMBEDDING_MODEL=nomic-embed-text
TALENT_EMBEDDING_DIMENSIONS=1536
# Số hồ sơ tiềm năng nhất được AI đọc sâu sau khi vector + full-text xếp hạng
# TOÀN kho. Mặc định 60; có thể tăng tối đa 200 sau khi đo latency/token thực tế.
TALENT_DEEP_READ_POOL=60
# Nạp hàng loạt (import lớn): đặt =0 rồi chạy rebuild_talent_vector_index sau.
# TALENT_INDEX_ON_SAVE=1
