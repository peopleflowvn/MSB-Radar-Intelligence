{"id":"det-009","kind":"deterministic","query":"Data Analyst ở Hà Nội hoặc HCM, không dưới 2 năm","plan":{"where":{"op":"and","children":[{"field":"title","value":"Data Analyst"},{"op":"or","children":[{"field":"location","value":"Hà Nội","kind":"geo"},{"field":"location","value":"HCM","kind":"geo"}]},{"field":"years_experience","value":2,"kind":"range","op":"gte"}]}},"truth":"sql","note":"AST lồng, phải giữ đúng thứ tự phép"}
