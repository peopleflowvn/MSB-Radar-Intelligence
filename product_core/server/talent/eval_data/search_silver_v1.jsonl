{"id":"det-001","kind":"deterministic","query":"Data Analyst ở Hà Nội trên 3 năm kinh nghiệm","plan":{"must":[{"field":"title","value":"Data Analyst"},{"field":"location","value":"Hà Nội","kind":"geo"},{"field":"years_experience","value":3,"kind":"range","op":"gte"}]},"truth":"sql","note":"AND ba tiêu chí; truth là chính tập SQL trả về"}
{"id":"det-002","kind":"deterministic","query":"Ứng viên ở Hanoi viết không dấu","plan":{"must":[{"field":"location","value":"Hanoi","kind":"geo"}]},"truth":"sql","note":"alias không dấu phải khớp cùng tập với 'Hà Nội'"}
{"id":"det-003","kind":"deterministic","query":"Kế toán nhưng không phải ở TP HCM","plan":{"must":[{"field":"title","value":"accountant"}],"exclude":[{"field":"location","value":"HCM","kind":"geo"}]},"truth":"sql","note":"NOT không được biến thành cho qua toàn kho"}
