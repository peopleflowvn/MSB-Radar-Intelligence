# MSB Radar Edge — mẫu khai báo tài khoản nguồn tuyển dụng.
# Chép file này thành `.env` (cùng thư mục edge/) rồi điền tài khoản.
#
# Khi mở phần mềm lần đầu (cauhinh.json chưa có tài khoản nguồn đó), email được
# nạp vào cấu hình, mật khẩu được lưu vào kho bí mật DPAPI của Windows — .env chỉ
# dùng để "mồi", không phải nơi lưu chính thức. Cấu hình đã nhập tay trong tab
# Cấu hình luôn được giữ, .env không đè lên.

# TOPCV_EMAIL=
# TOPCV_PASSWORD=
# VIETNAMWORKS_EMAIL=
# VIETNAMWORKS_PASSWORD=
# CAREERVIET_EMAIL=
# CAREERVIET_PASSWORD=
# VIECLAM24H_EMAIL=
# VIECLAM24H_PASSWORD=
# ITVIEC_EMAIL=
# ITVIEC_PASSWORD=
# JOBOKO_EMAIL=
# JOBOKO_PASSWORD=
# JOBSGO_EMAIL=
# JOBSGO_PASSWORD=
