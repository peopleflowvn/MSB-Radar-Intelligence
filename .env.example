# Radar service-to-service integration
RADAR_BASE_URL=https://radar.example
RADAR_SERVICE_TOKEN=
RADAR_INDEX_SCOPE_TOKEN=

# GreenNode OpenAI-compatible gateway
GREENNODE_BASE_URL=https://maas.example/v1
GREENNODE_API_KEY=
GREENNODE_MODEL_FAST=
GREENNODE_MODEL_DEEP=
GREENNODE_MODEL_VISION=
GREENNODE_MODEL_EMBEDDING=

# Disable framework telemetry in controlled deployments
HAYSTACK_TELEMETRY_ENABLED=false

# HTTP listener. Keep loopback locally; container compose overrides to 0.0.0.0.
INTELLIGENCE_BIND_HOST=127.0.0.1
INTELLIGENCE_PORT=8081
